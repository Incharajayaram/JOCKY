[run]
source = src/jocky
omit =
    */site-packages/*
    */distutils/*
    */tests/*
branch = True

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
precision = 2

[html]
directory = htmlcov

[xml]
output = coverage.xml
