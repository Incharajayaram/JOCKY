# syntax=docker/dockerfile:1
FROM python:3.11-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONPATH=/workspace/jocky/src
ENV TOOLCHAIN_PATH=/workspace/jocky/toolchain

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    curl \
    mingw-w64 \
    libssl-dev \
    libcurl4-openssl-dev \
    zlib1g-dev \
    unzip \
    && rm -rf /var/lib/apt/lists/*

# Install gcloud CLI (needed to pull toolchain from GCS)
RUN curl -fsSL https://dl.google.com/dl/cloudsdk/channels/rapid/downloads/google-cloud-cli-linux-x86_64.tar.gz \
    | tar -xz -C /usr/local && \
    /usr/local/google-cloud-sdk/install.sh --quiet --usage-reporting=false --command-completion=false
ENV PATH="/usr/local/google-cloud-sdk/bin:${PATH}"

WORKDIR /workspace/jocky

# Download toolchain from GCS.
# Locally: pass --secret id=gcs-key,src=./gcs-key.json
# Cloud Build: pass --secret id=gcs-token,src=/workspace/gcs-token.txt (short-lived access token)
RUN --mount=type=secret,id=gcs-key,required=false \
    --mount=type=secret,id=gcs-token,required=false \
    if [ -f /run/secrets/gcs-key ]; then \
        gcloud auth activate-service-account --key-file=/run/secrets/gcs-key && \
        gcloud storage cp gs://jocky-toolchain/toolchain.zip /tmp/toolchain.zip; \
    elif [ -f /run/secrets/gcs-token ]; then \
        curl -fsSL \
             -H "Authorization: Bearer $(cat /run/secrets/gcs-token)" \
             "https://storage.googleapis.com/storage/v1/b/jocky-toolchain/o/toolchain.zip?alt=media" \
             -o /tmp/toolchain.zip; \
    else \
        echo "No GCS credentials provided" && exit 1; \
    fi && \
    unzip -q /tmp/toolchain.zip -d /workspace/jocky && \
    rm /tmp/toolchain.zip

# Install Python deps first so this layer is cached independently of source changes
COPY web/backend/requirements.txt web/backend/requirements.txt
RUN pip install --no-cache-dir -r web/backend/requirements.txt

# Copy the full project (toolchain excluded via .dockerignore) and install jocky package
COPY . .
RUN pip install --no-cache-dir .

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/api/config || exit 1

WORKDIR /workspace/jocky/web/backend
CMD ["python", "-m", "uvicorn", "app:app", "--host", "0.0.0.0", "--port", "8000"]
