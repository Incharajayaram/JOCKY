# Build stage — compile the Vite/React app
FROM node:20-alpine AS builder

WORKDIR /app
COPY web/frontend/package*.json ./
RUN npm ci --prefer-offline --no-audit
COPY web/frontend/ ./

# Empty VITE_API_BASE so the built app uses same-origin paths.
# nginx routes /api/* and /ws/* to the backend container.
ENV VITE_API_BASE=
RUN npm run build

# Serve stage — nginx serves static files and proxies to backend
FROM nginx:1.25-alpine

COPY nginx.conf /etc/nginx/nginx.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
