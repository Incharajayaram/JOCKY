ffi printf(fmt: string, ...) -> i32;

fn fib(n: i32) -> i32 {
    if n <= 1 {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
}

fn main() -> i32 {
    let i: i32 = 0;
    while i < 10 {
        let r: i32 = fib(i);
        printf("fib(%d) = %d\n", i, r);
        i = i + 1;
    }
    return 0;
}
