    println("[*] Sending notification via Discord...")

    let message = "JOCKY Research Chain Complete - Operations: " + string(operations_count) + ", Drivers: " + string(array_len(loaded_drivers)) + ", Threat: " + string(threat_score)

    let webhook_url = "https://discord.com/api/webhooks/RESEARCH_WEBHOOK_ID/TOKEN"
