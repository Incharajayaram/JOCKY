enum Color {
    Red = 0,
    Green = 1,
    Blue = 2
};

fn color_name(c: i32) -> i32 {
    match c {
        0 => {
            return 1;
        },
        1 => {
            return 2;
        },
        _ => {
            return 0;
        }
    }
}

fn main() -> i32 {
