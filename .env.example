# Environment
ENVIRONMENT=development
NODE_ENV=development

# Frontend Configuration
FRONTEND_PORT=3000
VITE_API_BASE=http://localhost:8000

# Backend Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://frontend:3000

# Database Configuration
DATABASE_URL=sqlite:///./jocky_jobs.db
# For PostgreSQL: DATABASE_URL=postgresql://user:password@localhost/jocky

# Compilation Configuration
MAX_COMPILATION_TIME=600

# Compiler Configuration
BUILD_TYPE=Release
TOOLCHAIN_PATH=toolchain
JOCKY_TARGET=windows

# Production Configuration
FRONTEND_HOST=frontend:3000
BACKEND_HOST=backend:8000
CADDY_PORT=443

# Deployment Profile
DEPLOY_PROFILE=development
