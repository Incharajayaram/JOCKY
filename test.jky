ffi puts(s: string) -> i32;

fn calculate(a: i32, b: i32) -> i32 {
    let res: i32 = a;
    let i: i32 = 0;
    while i < b {
        res = res + a;
        i = i + 1;
    }
    return res;
}

fn main() -> i32 {
    let res: i32 = calculate(5, 3);
    if res == 20 {
        puts("Success 20");
    } else {
        puts("Failed");
    }
    return 0;
}
