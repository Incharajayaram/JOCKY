ffi jocky_reg_enum_key(key: i64, index: i32, name: i8*, name_size: i8*) -> i32;
ffi jocky_reg_enum_value(key: i64, index: i32, name: i8*, name_size: i8*, type_ptr: i8*) -> i32;
ffi jocky_reg_key_count(key: i64) -> i32;
ffi jocky_reg_value_count(key: i64) -> i32;
ffi jocky_reg_query_dword(key: i64, value_name: string, out_value: i8*) -> i32;
ffi jocky_reg_set_dword(key: i64, value_name: string, value: i32) -> i32;
ffi jocky_reg_query_string(key: i64, value_name: string, buffer: i8*, buffer_size: i32) -> i32;
ffi jocky_reg_set_string(key: i64, value_name: string, value: string) -> i32;
ffi jocky_reg_query_binary(key: i64, value_name: string, buffer: i8*, buffer_size: i8*) -> i32;
ffi jocky_reg_set_binary(key: i64, value_name: string, data: i8*, data_size: i32) -> i32;

// ---- Sandbox APIs ----
ffi sandbox_spawn_adv(executable: string, args: string) -> i32;
ffi sandbox_kill(pid: i32) -> i32;
ffi sandbox_set_limits_adv(pid: i32, max_memory: i32, max_cpu_ms: i32) -> i32;

// ---- Audit & Provenance APIs ----
ffi audit_init_adv(capacity: i32) -> i32;
ffi audit_log_adv(actor: string, action: string, input_hash: string, output_hash: string) -> i32;
ffi audit_verify_adv() -> i32;
ffi audit_export_adv(filename: string) -> i32;
ffi provenance_record_adv(source: string, transform: string, output: string) -> i32;
