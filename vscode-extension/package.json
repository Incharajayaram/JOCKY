{
  "name": "vscode-jocky",
  "displayName": "JOCKY Language Support",
  "description": "Syntax highlighting, IntelliSense, and snippets for JOCKY programming language",
  "version": "0.1.0",
  "publisher": "jocky-lang",
  "engines": {
    "vscode": "^1.60.0",
    "node": "^14.0.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "jocky",
    "language",
    "compiler",
    "systems",
    "low-level"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/jocky-lang/vscode-jocky"
  },
  "activationEvents": [
    "onLanguage:jocky"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "jocky",
        "aliases": [
          "JOCKY",
          "jocky"
        ],
        "extensions": [
          ".jky"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/icon-light.png",
          "dark": "./icons/icon-dark.png"
        }
      }
    ],
    "grammars": [
      {
        "language": "jocky",
        "scopeName": "source.jocky",
        "path": "./syntaxes/jocky.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "jocky",
        "path": "./snippets/jocky.json"
      }
    ],
    "commands": [
      {
        "command": "jocky.compile",
        "title": "JOCKY: Compile Current File"
      }
    ]
  },
  "devDependencies": {
    "typescript": "^4.5.0",
    "vscode": "^1.1.37",
    "@types/node": "^16.0.0",
    "@types/vscode": "^1.60.0"
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts"
  }
}
