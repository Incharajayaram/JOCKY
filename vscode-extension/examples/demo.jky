// JOCKY VS Code Extension Demo
// This file demonstrates all the language features supported by the extension

// Function with type annotations
fn add(a: i32, b: i32) -> i32 {
  return a + b;
}

// Struct definition with fields
struct Point {
  x: i32;
  y: i32;
};

// Enum with variants
enum Status {
  OK = 0,
  ERROR = 1,
  PENDING = 2
};

// Type alias
type ID = i64;

// Main entry point
fn main() -> void {
  // Variable bindings
  let result: i32 = add(10, 20);
  let message: string = "Hello, JOCKY!";
  let active: bool = true;

  // Conditionals
  if result > 25 {
    printf("Result is large\n");
  } else {
    printf("Result is small\n");
  }

  // While loop
  let counter: i32 = 0;
  while counter < 5 {
    printf("Count: %d\n", counter);
    counter = counter + 1;
  }

  // For loop
  for i = 0; i < 3; i = i + 1 {
    printf("Iteration: %d\n", i);
  }

  // Match expression
  let status: i32 = 0;
  match status {
    0 => printf("Status OK\n"),
    1 => printf("Status ERROR\n"),
  }

  // Array usage
  let numbers: i32[5] = [1, 2, 3, 4, 5];

  // Built-in functions
  let len: i64 = strlen(message);
  let size: i64 = sizeof(i32);

  // Lambda function
  let multiply: lambda (x: i32, y: i32) -> i32 = lambda (x: i32, y: i32) -> i32 { return x * y; };

  printf("Demo complete!\n");
}

// Function with struct parameter
fn print_point(p: Point) -> void {
  printf("Point: (%d, %d)\n", p.x, p.y);
}

// Helper function
fn check_status(s: Status) -> bool {
  match s {
    0 => return true,
    _ => return false,
  }
}

/* Block comment
   This is a multi-line comment
   demonstrating block comment syntax */

fn advanced_example() -> void {
  // String with escape sequences
  let text: string = "Hello\nWorld\t!";

  // Bitwise operations
  let a: i32 = 5;
  let b: i32 = 3;
  let bitwise_and: i32 = a & b;
  let bitwise_or: i32 = a | b;
  let left_shift: i32 = a << 1;
  let right_shift: i32 = b >> 1;

  // Logical operations
  let x: bool = true && false;
  let y: bool = true || false;
  let z: bool = !true;
}
