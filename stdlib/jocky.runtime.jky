module jocky.runtime

// ============================================================================
// Forensic Type Definitions
// ============================================================================

struct ForensicBytes {
    data: i8*;
    len: i32;
};

struct ForensicKV {
    key: &str;
    value: &str;
};

struct ForensicMetadata {
    items: i8*;
    count: i32;
    capacity: i32;
};

struct ForensicArtifact {
    plugin_name: &str;
    artifact_type: &str;
    timestamp: &str;
    raw: ForensicBytes;
    metadata: ForensicMetadata;
};

struct ForensicArtifactList {
    items: i8*;
    count: i32;
    capacity: i32;
};

struct ForensicIOC {
    type: &str;
    value: &str;
    source: &str;
    confidence: f32;
};

struct ForensicIOCList {
    items: i8*;
    count: i32;
};

struct ForensicEvent {
    event_type: &str;
    timestamp: &str;
    source_plugin: &str;
    description: &str;
    details: ForensicMetadata;
};

struct ForensicTimeline {
    items: i8*;
    count: i32;
};

struct ForensicParsedArtifact {
    artifact_type: &str;
    parser_name: &str;
    parsed_data: ForensicMetadata;
    iocs: ForensicIOCList;
    timeline_events: i8*;
    timeline_count: i32;
};

struct ForensicParsedArtifactList {
    items: i8*;
    count: i32;
};

